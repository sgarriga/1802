1130 GOSUB 1510
1140 IF L$="Y" THEN M1=M1-M1/2:W=F2:E=100:S=100:D(L)=P3:RETURN
1150 IF C2>1 THEN 1220
1160 GOSUB 1480:W=F2:S=100:E=100:D(L)=P3:PRINT "THE "E$" IS DEAD!":GOSUB 1500
1170 X1=X1+I:Z=Z+1
1180 IF X1<P2*2 THEN 1240
1190 P2=X1:H1=H1*3
1200 GOSUB 1480:PRINT "YOUR HIT PTS. HAVE BEEN RAISED.":GOSUB 1500
1210 GOTO 1240
1220 GOSUB 1480:PRINT "THE"E$" HAS "C2"HIT POINTS":GOSUB 1500
1230 GOSUB 1410
1240 RETURN
