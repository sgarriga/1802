1260 M1=M1+K1:GOSUB 1480:PRINT "YOU FOUND"K1"GOLD PIECE";
1270 IF K1<>1 THEN PRINT "S";
1280 PRINT "!":GOSUB 1500
1290 D(L)=F2:W=F2
1300 H2=H2-1:IF H2>100 THEN RETURN
