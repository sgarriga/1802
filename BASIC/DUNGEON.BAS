950 A=O1:IF E1+A=L THEN 1020
960 IF E1+A<L THEN 1000
970 IF A=B(3) THEN A=B(1)
980 IF A=B(9) THEN A=B(7)
990 GOTO 1020
1000 IF A=B(1) THEN A=B(3)
1010 IF A=B(7) THEN A=B(9)
1020 IF D(E+A)<=W1 THEN D(E1)=V1:RETURN
1030 D(E1)=E2:E=E+A:E2=D(E):D(E)=V1:IF E=L THEN E2=F2:GOSUB 1060
1040 RETURN
1050 Q1=V:E=Y
1060 GOSUB 1480:PRINT "AN ATTACK!!!":GOSUB 1500:P1=H1+X1
